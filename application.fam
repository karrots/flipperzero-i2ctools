App(
    appid="i2ctools",
    name="i2c Tools",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="i2ctools_app",
    sources=[
        "i2ctools.c",
        "i2cscanner.c",
        "i2csender.c",
        "i2csniffer.c",
        "views/main_view.c",
        "views/sniffer_view.c",
        "views/scanner_view.c",
        "views/sender_view.c",
        "views/infos_view.c",
        "views/config_view.c",
        "views/crypto_view.c",
        "crypto/crypto_service.c",
        "crypto/hal_furi_i2c.c",
    ],
    cdefines=["APP_I2CTOOLS"],
    requires=["gui"],
    stack_size=2 * 1024,
    order=175,
    fap_icon="i2ctools.png",
    fap_category="GPIO",
    fap_icon_assets="images",
    fap_author="@NaejEL",
    fap_version="1.1",
    fap_description="Set of i2c tools",
    
    fap_private_libs=[
        Lib(
            name="cryptoauthlib",
            
            # Source paths are relative to "lib/cryptoauthlib/"
            sources=[
                "lib/atca_basic.c",
                "lib/atca_cfgs.c",
                "lib/atca_debug.c",
                "lib/atca_device.c",
                "lib/atca_helpers.c",
                "lib/atca_iface.c",
                "lib/atca_utils_sizes.c",
                "lib/cal_buffer.c",
                "lib/crypto/atca_crypto_sw_sha2.c",
                "lib/crypto/hashes/sha1_routines.c",
                "lib/crypto/hashes/sha2_routines.c",
                "lib/hal/atca_hal.c",
                "lib/host/atca_host.c",
                "lib/calib/calib_aes.c",
                "lib/calib/calib_aes_gcm.c",
                "lib/calib/calib_basic.c",
                "lib/calib/calib_checkmac.c",
                "lib/calib/calib_command.c",
                "lib/calib/calib_counter.c",
                "lib/calib/calib_delete.c",
                "lib/calib/calib_derivekey.c",
                "lib/calib/calib_ecdh.c",
                "lib/calib/calib_execution.c",
                "lib/calib/calib_genkey.c",
                "lib/calib/calib_gendig.c",
                "lib/calib/calib_helpers.c",
                "lib/calib/calib_hmac.c",
                "lib/calib/calib_info.c",
                "lib/calib/calib_kdf.c",
                "lib/calib/calib_lock.c",
                "lib/calib/calib_mac.c",
                "lib/calib/calib_nonce.c",
                "lib/calib/calib_packet.c",
                "lib/calib/calib_privwrite.c",
                "lib/calib/calib_random.c",
                "lib/calib/calib_read.c",
                "lib/calib/calib_secureboot.c",
                "lib/calib/calib_selftest.c",
                "lib/calib/calib_sha.c",
                "lib/calib/calib_sign.c",
                "lib/calib/calib_updateextra.c",
                "lib/calib/calib_verify.c",
                "lib/calib/calib_write.c",
            ],
            
            # Include paths for your APP (relative to "lib/cryptoauthlib/")
            fap_include_paths=[
                "lib",
                "lib/hal",
                "../../crypto", # Provides crypto/atca_config.h to your app files
            ],
            
            # Include paths for the LIBRARY (relative to app root)
            cincludes=[
                "crypto",               # Provides crypto/atca_config.h to the library files
                "lib/cryptoauthlib/lib",
                "lib/cryptoauthlib/lib/hal",
            ],

            cdefines=[
                "ATCA_HAL_CUSTOM",
                "ATCA_CHECK_PARAMS_EN=1",
                "ATCA_TA_SUPPORT=0",
                "ATCAC_SHA384_EN=0",
                "ATCAC_SHA512_EN=0",
                "ATCACERT_COMPCERT_EN=0",
                "ATCACERT_FULLSTOREDCERT_EN=0",
                "ATCACERT_INTEGRATION_EN=0",
                "ATCA_MAX_HAL_CACHE=1",
                "ATCA_POST_DELAY_MSEC=25",
            ],

            # FIX: Added more flags to ignore the new library warnings
            cflags=[
                "-Wno-error=unused-parameter",
                "-Wno-error=incompatible-pointer-types",
                "-Wno-error=unused-variable",
            ],
        ),
    ],
)

